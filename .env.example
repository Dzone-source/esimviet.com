# ─────────────────────────────────────────────────────────────────────────────
# eSIM Global – Local Development Environment (reference)
#
# This is a SINGLE reference file. The app actually loads two separate files:
#   • backend/.env         (copy from backend/.env.example)
#   • frontend/.env.local  (copy from frontend/.env.local.example)
#
# Copy the matching section below into each file and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── backend/.env ─────────────────────────────────────────────────────────────
# Server
PORT=4000
NODE_ENV=development

# Database (local MariaDB). Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://esim_user:change_this_password@localhost:3306/esim_db"

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=eSIM Viet
ADMIN_NOTIFICATION_EMAIL=support@esimviet.com

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:3000

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ── frontend/.env.local ──────────────────────────────────────────────────────
# Backend API URL. In local dev, Next.js proxies /api/* to this address.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
NEXT_PUBLIC_SITE_NAME=eSIM Viet
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FB_MESSENGER=your_facebook_page_id
