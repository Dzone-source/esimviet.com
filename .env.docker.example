# ─────────────────────────────────────────────────────────────────────────────
# eSIM Global – Docker Environment
# Copy to .env before running:  cp .env.docker.example .env
# ─────────────────────────────────────────────────────────────────────────────

# MariaDB
MYSQL_ROOT_PASSWORD=change_root_password_here
MYSQL_DATABASE=esim_db
MYSQL_USER=esim_user
MYSQL_PASSWORD=change_db_password_here

# Database host inside Docker network (do not change)
DB_HOST=mariadb
DB_PORT=3306

# Seed database on first start (true/false)
SEED_DATABASE=true

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=eSIM Global

# Public URLs – change to your real domain
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
NEXT_PUBLIC_SITE_NAME=eSIM Global
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_FB_MESSENGER=your_facebook_page_id

# Nginx port exposed on host (aaPanel will reverse-proxy to this)
NGINX_HTTP_PORT=8080

# Optional: expose backend/frontend directly for debugging (leave empty to disable)
# BACKEND_PORT=4000
# FRONTEND_PORT=3000
