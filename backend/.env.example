# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="mysql://esim_user:change_this_password@localhost:3306/esim_db"

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@youresim.com
EMAIL_FROM_NAME=eSIM Viet
ADMIN_NOTIFICATION_EMAIL=support@esimviet.com

# Frontend URL (CORS + PayPal fallback)
FRONTEND_URL=http://localhost:3000
# Optional extra origins (comma-separated), e.g. https://5gtrip.com
# ALLOWED_ORIGINS=

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
